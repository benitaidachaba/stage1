# Populated by `neon env pull` for the linked branch. Keep these server-only.
DATABASE_URL=postgresql://user:password@your-host-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@your-host.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://your-branch.neonauth.aws.neon.tech/neondb/auth
# Generate once with: openssl rand -base64 32 (never expose it to the browser).
NEON_AUTH_COOKIE_SECRET=

# Optional server-side assistant/transcription:
# GOOGLE_API_KEY=
